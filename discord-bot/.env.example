# Copia este archivo como .env y rellena los valores. El .env NUNCA se sube al repo.

# --- Discord (obligatorio) ---
# Discord Developer Portal → tu aplicación → Bot → Reset Token
DISCORD_TOKEN=
# Discord Developer Portal → tu aplicación → General Information → Application ID
DISCORD_CLIENT_ID=
# En Discord: Ajustes → Avanzado → Modo desarrollador; luego clic derecho en tu servidor → Copiar ID
GUILD_ID=

# --- Twitch (para avisos de directo) ---
# https://dev.twitch.tv/console/apps → Register Your Application
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- YouTube Data API (opcional: estrenos programados y contador de suscriptores) ---
# https://console.cloud.google.com → APIs y servicios → habilitar "YouTube Data API v3" → Credenciales → Clave de API
YOUTUBE_API_KEY=

# --- Feeds RSS de redes sin API pública gratuita (ver README) ---
TIKTOK_FEED_URL=
INSTAGRAM_FEED_URL=
TWITTER_FEED_URL=

# --- Minecraft (dirección del servidor, p. ej. play.miservidor.com o 1.2.3.4:25565) ---
MINECRAFT_SERVER=
# RCON (opcional, para /whitelist). En server.properties: enable-rcon=true, rcon.password=..., rcon.port=25575
MINECRAFT_RCON_HOST=
MINECRAFT_RCON_PORT=25575
MINECRAFT_RCON_PASSWORD=

# Carpeta donde se guarda el estado del bot (opcional, por defecto ./data)
DATA_DIR=
